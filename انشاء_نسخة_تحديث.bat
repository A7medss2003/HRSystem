@echo off
chcp 65001 > nul
title معالج إنشاء نسخة التحديث التراكمية - منظومة الموارد البشرية

echo ====================================================================
echo          معالج إنشاء وتجهيز نسخة التحديث للمنظومة (In-Place Upgrade)
echo ====================================================================
echo.
echo [1] سيتم ترقية رقم الإصدار تلقائياً (Patch version bump).
echo [2] بناء ملفات الواجهة والبرنامج (Vite Build).
echo [3] تجميع حزمة التحديث ومثبت ويندوز (Electron Builder).
echo [4] نقل ملفات التحديث تلقائياً إلى مجلد [HR_Update] الجاهز للفلاشة.
echo.
echo اضغط أي مفتاح للبدء...
pause > nul

echo.
echo [+] جاري تنفيذ البناء...
npm run build:update

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ====================================================================
    echo [✓] تم تجهيز نسخة التحديث بنجاح!
    echo [✓] توجه إلى مجلد [HR_Update] وانسخه كما هو إلى الفلاشة USB.
    echo ====================================================================
) else (
    echo.
    echo [X] حدث خطأ أثناء البناء. يرجى التأكد من تثبيت الحزم (npm install) وإغلاق أي نسخة مشغلة من البرنامج.
)

echo.
pause
